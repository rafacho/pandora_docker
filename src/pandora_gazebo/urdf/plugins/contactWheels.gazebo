<?xml version="1.0"?>
<robot name="pandora" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- Plugin do sensor de contato -->
	<xacro:macro name="wheel_contacts_config" params="leg_num">
		<gazebo reference="wheel_${leg_num}">
			<!-- ROS2 port note (2026-08-04): libgazebo_ros_bumper.so (Gazebo Classic)
			     replaced by Gazebo Sim's native contact sensor, driven by the
			     gz-sim-contact-system world plugin (flat.world/sinusoidal.world).
			     Fix (2026-08-25): unlike Imu, gz-sim's Contact system ignores the
			     <topic> below entirely, it always publishes on the
			     auto-generated, world-scoped default topic
			     /world/<world>/model/pandora/link/wheel_N/sensor/wheel_N_contact_sensor/contact
			     (confirmed with `gz topic -i`), never on pandora/contacts_N. The
			     <topic> element is kept here for documentation/forward-compat
			     only; the real bridging target lives in
			     pandora_gazebo/config/ros_gz_bridge.yaml (templated per-world,
			     resolved by pandora_launch/bringup.launch.py). -->
			<sensor name="wheel_${leg_num}_contact_sensor" type="contact">
				<always_on>true</always_on>
				<update_rate>25</update_rate>
				<contact>
					<collision>wheel_${leg_num}_collision</collision>
				</contact>
				<topic>pandora/contacts_${leg_num}</topic>
			</sensor>

			<!-- *************************************************************************** -->

			<collision>
				<surface>				
					<friction>
						<ode>
							<!-- 0 <= mu <= 1 -->
							<mu>1</mu>
							<mu2>1</mu2>
							<fdir1>0.00000 0.000000 0.000000</fdir1>
							<slip1>0.000</slip1>
							<slip2>0.000</slip2>
						</ode>
						<bullet>
							<friction>0.5</friction>
							<friction2>0.5</friction2>
						</bullet>
					</friction>
					<contact>
						<ode>
							<!-- <soft_cfm>0.5</soft_cfm> -->
							<soft_erp>0.05</soft_erp>
							<max_vel>0.0001</max_vel>
							<min_depth>0.005</min_depth>

							<!-- <kp>2.1e15</kp> -->
							<!-- <kd>1</kd> -->
						</ode>
						<bullet>
							<soft_cfm>0.007</soft_cfm>
							<soft_erp>0.25</soft_erp>
							<kp>1000000</kp>
							<kd>5</kd>
						</bullet>
					</contact>
				</surface>
			</collision>
		</gazebo>
	</xacro:macro>
</robot>