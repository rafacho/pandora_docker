<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="sinusoidal">
        <scene>
            <ambient>0.6 0.6 0.6 1</ambient>
            <background>0.7 0.8 0.9 1</background>
        </scene>
        <!-- Physics tuning matches test_world.world (2026-08-06 finding):
             0.001 destabilizes the SEA actuator model in custom_controller
             (Ks=50000 spring vs a small ~0.645 reflected motor inertia),
             causing the virtual actuator position and commanded link effort
             to end up with the wrong sign. 0.00025 (4000 Hz) plus PGS/ODE is
             the confirmed-stable configuration. -->
        <physics name="0.025ms" type="ignore">
            <max_step_size>0.00025</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <dart>
              <solver>
                <solver_type>pgs</solver_type>
              </solver>
              <collision_detector>ode</collision_detector>
            </dart>
        </physics>
        <gravity>0 0 -9.8</gravity>
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
          <engine>
            <filename>gz-physics-dartsim-plugin</filename>
          </engine>
        </plugin>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <!-- Required for rendering-based sensor tags (camera, gpu_lidar, ...)
             to actually run and publish on gz-transport: declaring a sensor
             on a link/collision is not enough by itself. Without it, ros_gz_bridge
             still advertises the mapped ROS2 topic (it just mirrors the
             config), but zero messages ever flow because gz-sim never
             produces any. NOTE: this system does NOT cover imu/contact
             sensors, those need their own dedicated systems below. -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
        <!-- Fix (2026-08-24): imu.gazebo/contactWheels.gazebo assumed these
             were already declared here ("pandora.world" in their comments,
             a file that no longer exists), but only gz-sim-sensors-system was
             actually present. gz-sim-sensors-system only drives
             rendering-based sensors (camera, gpu_lidar, ...); IMU and contact
             sensors are handled by their own separate systems, which were
             missing entirely, so /imu and /pandora/contacts_N were never
             produced no matter what the URDF declared. -->
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <include>
            <name>terrain</name>
            <uri>model://sinusoidal</uri>
        </include>
    </world>
</sdf>