<?xml version="1.0" ?>
<sdf version="1.5">
    <model name="heightmap">
      <static>true</static>
      <link name="link">
        <collision name="collision_terrain">
          <geometry>
            <heightmap>
	            <uri>model://heightmap/materials/textures/image.png</uri>
              <size>100 100 1</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
                <fdir1>0.000000 0.000000 0.000000</fdir1>
                <slip1>0.000000</slip1>
                <slip2>0.000000</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual_terrain">
          <!-- ROS2 port note (2026-08-04): the three <texture>/<blend> layers below
               pointed at "file://media/materials/textures/...", Gazebo Classic's
               bundled media directory, which does not ship with Gazebo Sim. Rather
               than leave dangling file:// refs that fail to resolve at runtime,
               they were dropped; the terrain still renders (flat/default material)
               from the real heightmap raster this package ships
               (materials/textures/image.png). Re-add real texture files under this
               package and restore per-layer blending here if textured terrain is
               wanted. -->
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <uri>model://heightmap/materials/textures/image.png</uri>
	            <size>100 100 1</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>
</sdf>
