<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="pandora_world">
    <!-- ROS2 port note (2026-08-04): Gazebo Sim (unlike Gazebo Classic) does not
         auto-load any systems: physics, sensors, contact reporting, the scene
         broadcaster (needed for the GUI/ros_gz_bridge to see the world at all)
         and user commands (needed for GUI spawn/delete/move) must each be listed
         explicitly. This replaces the implicit ODE-engine loading Classic did. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <gravity>0 0 -9.81</gravity>

    <!-- ROS2 port note: the ROS1 world tuned ODE-specific solver/constraint
         parameters (iters, sor, cfm, erp, contact_max_correcting_vel,
         contact_surface_layer). Gazebo Sim's default physics engine is DART
         (dartsim), which does not take those ODE knobs; only the
         engine-agnostic step size / update rate carry over as-is. The DART
         solver will need its own tuning pass; see code review 2026-08-04. -->
    <physics name="pandora_physics" type="dartsim">
      <max_step_size>0.00025</max_step_size>
      <real_time_update_rate>4000</real_time_update_rate>
      <!-- Switched from DART's default "dantzig" LCP solver to "pgs"
           (Projected Gauss-Seidel, iterative). Dantzig is an exact solver
           that can fail hard (or, per our DetachableJoint experiment, blow
           up) on over-constrained/redundant/inconsistent constraint sets;
           PGS degrades more gracefully instead of throwing/crashing. Syntax
           confirmed against gz-sim's own worlds/physics_options.sdf example. -->
      <dart>
        <solver>
          <solver_type>pgs</solver_type>
        </solver>
      </dart>
    </physics>

    <!-- ROS2 port note: "model://heightmap" resolves via GZ_SIM_RESOURCE_PATH
         (set in pandora_launch's bringup.launch.py) instead of Classic's
         GAZEBO_MODEL_PATH / ~/.gazebo/models. -->
    <include>
      <uri>model://heightmap</uri>
    </include>

    <!-- ROS2 port note: "model://sun" (a Gazebo Classic bundled model) has no
         guaranteed equivalent in Gazebo Sim's asset set; replaced with the
         standard directional-light boilerplate used by every gz-sim example
         world. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ROS2 port note: Gazebo Classic's <gui><camera> user_camera has no
         gz-sim equivalent (camera pose is set from the GUI config / the
         gz-gui "Camera pose" plugin instead); dropped rather than left as
         silently-ignored dead XML. -->

  </world>
</sdf>
