<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="flat">
        <physics name="0.025ms" type="ignore">
          <!-- Fix (2026-08-06): was 0.001 (copied from gz-sim's "1ms" example
               profile). Confirmed by direct testing that this destabilizes
               the SEA actuator model in custom_controller (Ks=50000 spring
               vs a small ~0.645 reflected motor inertia): at 0.001 the
               virtual actuator position and the commanded link effort both
               end up with the WRONG sign relative to the desired position.
               0.00025 (4000 Hz) matches pandora.world and the actuator
               model's original tuning; confirmed the sign/direction is
               correct at this step size, see chat 2026-08-06. -->
          <max_step_size>0.00025</max_step_size>
          <real_time_factor>1.0</real_time_factor>
          <dart>
            <solver>
              <!-- <solver_type>dantzig</solver_type>  -->
              <solver_type>pgs</solver_type>
            </solver>
            <!-- <collision_detector>bullet</collision_detector> -->
            <!-- <collision_detector>dart</collision_detector> -->
            <!-- <collision_detector>fcl</collision_detector> -->
            <collision_detector>ode</collision_detector>
          </dart>
          <bullet>
            <solver>
              <type>sequential_impulse</type>
              <min_step_size>0.0001</min_step_size>
              <iters>50</iters>
              <sor>1.3</sor>
            </solver>
            <constraints>
              <cfm>0.2</cfm>
              <contact_surface_layer>0.001</contact_surface_layer>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
            </constraints>
          </bullet>
        </physics>
        <plugin name="gz::sim::systems::Physics"
          filename="gz-sim-physics-system">
          <engine>
            <filename>gz-physics-dartsim-plugin</filename>
            <!-- <filename>gz-physics-bullet-plugin</filename> -->
            <!-- <filename>gz-physics-bullet-featherstone-plugin</filename> -->
          </engine>
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <!-- Required for rendering-based sensor tags (camera, gpu_lidar, ...)
             to actually run and publish on gz-transport: declaring a sensor
             on a link/collision is not enough by itself. Without it, ros_gz_bridge
             still advertises the mapped ROS2 topic (it just mirrors the
             config), but zero messages ever flow because gz-sim never
             produces any. NOTE: this system does NOT cover imu/contact
             sensors, those need their own dedicated systems below. -->
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
        <!-- Fix (2026-08-24): imu.gazebo/contactWheels.gazebo assumed these
             were already declared here ("pandora.world" in their comments,
             a file that no longer exists), but only gz-sim-sensors-system was
             actually present. gz-sim-sensors-system only drives
             rendering-based sensors (camera, gpu_lidar, ...); IMU and contact
             sensors are handled by their own separate systems, which were
             missing entirely, so /imu and /pandora/contacts_N were never
             produced no matter what the URDF declared. -->
        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>
        <plugin
            filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <!--<pose relative_to='__model__'>0 0 0 0 0 0</pose>-->
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>50 50</size>
                        </plane>
                    </geometry>
                    
                    <material>
                        <ambient>1.0 1.0 1.0 1</ambient>
                        <diffuse>1.0 1.0 1.0 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                        <pbr>
                            <metal>
                                <albedo_map>model://sinusoidal/texture/clay_albedo.png</albedo_map>
                                <normal_map>model://sinusoidal/texture/clay_normal.png</normal_map>
                                <roughness_map>model://sinusoidal/texture/clay_roughness.png</roughness_map>
                                <metalness>0.0</metalness>
                            </metal>
                        </pbr>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>